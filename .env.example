# رمز عبور مدیر اولیه (فقط هنگام اجرای npm run seed استفاده می‌شود)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now

# کلید امضای نشست (اختیاری؛ اگر نباشد، به‌صورت خودکار در data/.session-secret ساخته می‌شود)
SESSION_SECRET=

# مسیر ذخیره‌ی پایگاه داده و تصاویر آپلودشده (پیش‌فرض: ./data)
DATA_DIR=

# آدرس سایت برای sitemap و متادیتا
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── کانال تلگرام (اختیاری): هر پست کانال خودکار در سایت منتشر می‌شود و از متنش محصول متغیر ساخته می‌شود ──
# ربات را از @BotFather بسازید و ادمین کانال کنید. توکن را هرگز در گیت نگذارید.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL=
# اگر سرور به api.telegram.org دسترسی ندارد، آدرس پروکسی/آینه (پیش‌فرض: https://api.telegram.org)
TELEGRAM_API_BASE=
# ورودی امن برای رباتی که خودش کانال را می‌خواند و پست‌ها را به POST /api/channel/ingest می‌فرستد.
# حداقل ۱۶ نویسه‌ی تصادفی؛ خالی = این مسیر خاموش است. هدر: x-channel-secret
CHANNEL_INGEST_SECRET=
