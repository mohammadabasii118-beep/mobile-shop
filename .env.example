# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (any provider: local, VPS, Neon, ...). Only this variable ties the app to a database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Random secret, at least 32 characters (e.g. `openssl rand -base64 48`). Signs OTP hashes and reset tickets.
AUTH_SECRET=""

# Public URL of the site. Use https:// in production (cookies are marked Secure when it starts with https).
APP_URL="http://localhost:3000"

# Private storage for payment receipts. Must NOT be inside public/. Back this directory up.
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage"

# OTP delivery. "console" prints codes to the server log (development only).
# Add a real provider by implementing SmsProvider in lib/server/auth/sms.ts.
SMS_PROVIDER="console"

# Set to 1 ONLY behind a reverse proxy (nginx, Caddy, ...) that overwrites X-Forwarded-For.
# Leave 0 otherwise, or clients could spoof their IP and dodge rate limits.
TRUST_PROXY="0"

# Reserved for later phases (Telegram / e-mail notifications, S3 storage)
TELEGRAM_BOT_TOKEN=""
EMAIL_SMTP_URL=""
