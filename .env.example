# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (any provider: local, VPS, Neon, ...). Only this variable ties the app to a database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Random secret, at least 32 characters (e.g. `openssl rand -base64 48`). Signs OTP hashes and reset tickets.
AUTH_SECRET=""

# Public URL of the site. Use https:// in production (cookies are marked Secure when it starts with https).
APP_URL="http://localhost:3000"

# Private storage for payment receipts. Must NOT be inside public/. Back this directory up.
STORAGE_DRIVER="local"
# Private receipts live in $UPLOAD_DIR/receipts; public admin uploads (images) in $UPLOAD_DIR/public/images. Back this directory up.
UPLOAD_DIR="./storage"

# OTP delivery. "console" prints codes to the server log (development only).
# Add a real provider by implementing SmsProvider in lib/server/auth/sms.ts.
SMS_PROVIDER="console"

# Set to 1 ONLY behind a reverse proxy (nginx, Caddy, ...) that overwrites X-Forwarded-For.
# Leave 0 otherwise, or clients could spoof their IP and dodge rate limits.
TRUST_PROXY="0"

# Notifications are always stored in-app. External channels are OFF until listed here AND configured:
#   NOTIFY_CHANNELS="sms,email,telegram"   (empty = in-app only)
# A listed channel without credentials is recorded as "skipped", never half-sent.
NOTIFY_CHANNELS=""
TELEGRAM_BOT_TOKEN=""
EMAIL_SMTP_URL=""

# ---- Phase 5 (production) ----
# Max connections in this process's PostgreSQL pool (keep pool × processes below max_connections).
DB_POOL_MAX="10"
# Production refuses to start with a placeholder AUTH_SECRET or an http:// APP_URL. Set to 1 ONLY for a private local check
# of the production build (never on a real server).
# ALLOW_INSECURE_HTTP="1"
# Print every SQL statement with its duration (diagnostics only).
# DB_QUERY_LOG="1"
# One-time inputs for `npm run bootstrap:prod` (pass on the command line; do not keep them in .env):
#   BOOTSTRAP_ADMIN_PHONE, BOOTSTRAP_ADMIN_PASSWORD
