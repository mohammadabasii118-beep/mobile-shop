# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Random string, at least 32 chars (openssl rand -base64 48)
AUTH_SECRET=""
APP_URL="http://localhost:3000"
# Private directory for payment receipts / ticket attachments (NOT under public/)
UPLOAD_DIR="./storage"
# Optional, add later: SMS / email / telegram providers
SMS_API_KEY=""
EMAIL_SMTP_URL=""
TELEGRAM_BOT_TOKEN=""
