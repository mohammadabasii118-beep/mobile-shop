# ---- Core ----
NODE_ENV=production
# docker compose builds DATABASE_URL from POSTGRES_PASSWORD; set DATABASE_URL yourself for non-docker runs
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://vpn:CHANGE_ME@localhost:5432/vpnbot?schema=public
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
APP_URL=https://bot.example.com
PORT=3000
# Private receipt storage (never expose via web server)
RECEIPT_DIR=./data/receipts
LOG_LEVEL=info

# ---- X-UI / 3x-ui (Sanaei) ----
# Use XUI_API_TOKEN (Bearer) when your panel supports it, otherwise username/password.
XUI_BASE_URL=
XUI_USERNAME=
XUI_PASSWORD=
XUI_API_TOKEN=
# Public subscription base = the panel's subscription URL WITHOUT the client's subId, e.g. https://sub.example.com:2096/sub
# (panel → Settings → Subscription: domain + port + URI path). Leave empty to hide subscription links.
XUI_SUB_BASE_URL=
# Public host used inside generated configs if the inbound has no "listen" domain
XUI_PUBLIC_HOST=
# "xui" for real panel. "mock" is ONLY allowed when NODE_ENV != production
VPN_PROVIDER=xui

# ---- Card to card ----
CARD_TO_CARD_ENABLED=true
CARD_HOLDER=
CARD_NUMBER=
BANK_NAME=
PAYMENT_INSTRUCTIONS=

# ---- Crypto (architecture ready, disabled until a real verifier is configured) ----
CRYPTO_ENABLED=false

# ---- Payment verification ----
# Shared secret (HMAC-SHA256) for POST /webhooks/bank-transactions (bank SMS / bank API ledger feed)
BANK_WEBHOOK_SECRET=
# Optional tesseract OCR (requires `npm i tesseract.js`)
OCR_ENABLED=false

# ---- Web admin panel (/admin) ----
# Signs panel sessions. If empty it is derived from BOT_TOKEN. Login is via the bot: admins send /panel to get a one-time link.
PANEL_SESSION_SECRET=
# true only when running behind your own reverse proxy (uses X-Forwarded-For for audit IPs)
TRUST_PROXY=false

# ---- Network helpers (only if needed) ----
# If api.telegram.org is blocked from your server, use ONE of these:
TELEGRAM_PROXY_URL=
TELEGRAM_API_ROOT=
# Panel behind a self-signed HTTPS certificate (opt-in, weakens MITM protection)
XUI_TLS_INSECURE=false
