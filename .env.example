# ---- Database ----
# Postgres connection string. On a VPS/Docker use e.g. postgresql://user:pass@localhost:5432/caseline
# On managed hosting use Neon / Supabase / Railway / Liara Postgres connection string.
DATABASE_URL="postgresql://caseline:caseline@localhost:5432/caseline?schema=public"

# ---- Auth (NextAuth) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="کیس لاین"

# ---- Payment: Zarinpal (reference gateway, swappable in lib/payment) ----
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
ZARINPAL_SANDBOX="true"
ZARINPAL_CALLBACK_URL="http://localhost:3000/api/payment/callback"

# ---- Supplier API (not connected yet — placeholders for future integration) ----
SUPPLIER_API_URL=""
SUPPLIER_API_KEY=""
