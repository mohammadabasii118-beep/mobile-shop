# Copy to .env (optional for the demo — safe dev defaults are built in)
NEXT_PUBLIC_APP_NAME="Social Manager"
DEMO_MODE=true
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_manager

# --- Live Telegram (optional). When both are set, the panel reads your real channel via long polling ---
# TELEGRAM_BOT_TOKEN=123456:ABC...   (from @BotFather; the bot must be an ADMIN of the channel)
# TELEGRAM_CHANNEL=@yourchannel
# TELEGRAM_MODE=mock                 (force demo Telegram even if the two variables above are set)

# --- Instagram (no Meta API). mock = demo | manual = "Ready to Post" queue | unofficial = + Publish button ---
# INSTAGRAM_MODE=manual
# Unofficial publishing (private mobile API, VIOLATES Instagram ToS - the account can be limited/banned):
# INSTAGRAM_MODE=unofficial
# IG_SIDECAR_SECRET=<16+ random chars>   # same value for the panel and the Python sidecar
# IG_SIDECAR_URL=http://127.0.0.1:8765
# IG_USERNAME=your_instagram_username    # read by the sidecar only
# IG_PASSWORD=your_password              # read by the sidecar only. Keep .env at chmod 600
# IG_DAILY_LIMIT=5                       # max posts per 24h from the panel
# IG_AUTO_PUBLISH=false                  # true = publish without confirmation (not recommended)
# IG_DRY_RUN=1                           # sidecar test mode: fake publishing

# --- Future real integrations (NOT used yet) ---
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# OPENAI_API_KEY=
