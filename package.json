{
  "name": "telegram-vpn-sales-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram VPN sales bot with X-UI/3x-ui provisioning",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "tsx demo/server.ts",
    "demo:script": "tsx demo/transcript.ts",
    "seed": "tsx src/scripts/seed.ts",
    "xui:check": "tsx src/scripts/xuiCheck.ts",
    "preflight": "tsx src/scripts/preflight.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.5",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^7.0.6",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
