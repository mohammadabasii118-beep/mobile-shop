// DRAFT — NOT applied to any database and NOT part of prisma/schema.prisma yet.
// Purely additive: one new enum value + new tables. No existing table/column is
// altered, renamed or dropped (Order, Product, Payment, Wallet... are untouched).

// enum Role { CUSTOMER ADMIN STAFF SUPER_ADMIN }   <- only change to an existing type

enum MediaKind {
  IMAGE
  VIDEO
  ANIMATION // Lottie/JSON or animated WebP/APNG
}

enum DesignStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BannerPlacement {
  HERO
  PROMO
  CAMPAIGN
}

enum MotionMode {
  OFF
  CSS
  THREE_D
  VIDEO
  ANIMATION
}

model MediaAsset {
  id          String    @id @default(cuid())
  kind        MediaKind
  url         String // /uploads/design/<file> (persistent dir, see plan §6)
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Float?
  alt         String?
  createdById String?
  createdBy   User?     @relation("MediaAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  bannersDesktop Banner2[] @relation("BannerDesktopImage")
  bannersMobile  Banner2[] @relation("BannerMobileImage")
  motions        MotionSetting[] @relation("MotionAsset")
  motionPosters  MotionSetting[] @relation("MotionPoster")
}

// Named Banner2 in the draft only to avoid clashing with the existing `Banner`
// model, which stays untouched. Final name: DesignBanner (mapped to its own table).
model Banner2 {
  id              String          @id @default(cuid())
  placement       BannerPlacement @default(HERO)
  status          DesignStatus    @default(DRAFT)
  eyebrow         String?
  title           String
  subtitle        String?
  primaryLabel    String?
  primaryUrl      String?
  secondaryLabel  String?
  secondaryUrl    String?
  desktopImageId  String?
  mobileImageId   String?
  desktopImage    MediaAsset?     @relation("BannerDesktopImage", fields: [desktopImageId], references: [id], onDelete: SetNull)
  mobileImage     MediaAsset?     @relation("BannerMobileImage", fields: [mobileImageId], references: [id], onDelete: SetNull)
  order           Int             @default(0)
  isActive        Boolean         @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([placement, status, isActive, order])
  @@map("DesignBanner")
}

model MotionSetting {
  id            String      @id @default(cuid())
  key           String      @unique // HERO_SCENE | BRAND_FILM | SECTION_REVEAL | PARALLAX
  mode          MotionMode  @default(CSS)
  enabled       Boolean     @default(true)
  assetId       String?
  posterId      String? // fallback for mobile / weak devices / reduced motion
  asset         MediaAsset? @relation("MotionAsset", fields: [assetId], references: [id], onDelete: SetNull)
  poster        MediaAsset? @relation("MotionPoster", fields: [posterId], references: [id], onDelete: SetNull)
  params        Json? // validated by a zod schema per key (never free code)
  updatedAt     DateTime    @updatedAt
}

model ThemeSettings {
  id          String   @id @default("singleton")
  logoLight   String?
  logoDark    String?
  favicon     String?
  colors      Json? // whitelist of token names -> #hex, validated
  brandTexts  Json? // about/tagline/benefits copy
  updatedAt   DateTime @updatedAt
}

model PageLayout {
  id          String       @id @default(cuid())
  pageKey     String // "home"
  status      DesignStatus @default(DRAFT)
  version     Int
  blocks      Json // [{ id, type, visible, props }] — type from a fixed registry
  note        String?
  createdById String?
  createdBy   User?        @relation("PageLayoutCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  publishedAt DateTime?

  @@unique([pageKey, version])
  @@index([pageKey, status])
}

model DesignAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. banner.update, layout.publish
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}
