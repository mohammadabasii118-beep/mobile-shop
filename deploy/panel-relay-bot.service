# Runs on the BOT SERVER. Makes the loopback end of the reverse tunnel reachable from docker containers
# (https://host.docker.internal:12020/<panel-path>), without exposing it on a public interface.
[Unit]
Description=Relay docker bridge to the reverse SSH tunnel (X-UI panel)
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:12020,bind=172.17.0.1,fork,reuseaddr TCP:127.0.0.1:12020
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
